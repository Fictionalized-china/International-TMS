{
  "name": "international-tms",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build && node scripts/sanitize-build.mjs",
    "build:mysql": "node scripts/build-mysql.mjs",
    "ci": "npm run typecheck && npm run test && npm run build",
    "dev": "npm run db:migrate:local && react-router dev",
    "dev:win": "npm run db:migrate:local && react-router dev --clearScreen=false --host 127.0.0.1 --port 5189 --strictPort",
    "typecheck": "wrangler types && react-router typegen && tsc -b",
    "deploy": "npm run db:migrate:remote && npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply international-tms --local",
    "db:migrate:remote": "wrangler d1 migrations apply international-tms --remote",
    "db:bootstrap:mysql": "python scripts/export-mysql-bootstrap.py",
    "db:init:mysql": "node scripts/init-mysql.mjs",
    "db:verify:mysql": "node scripts/verify-mysql.mjs",
    "db:migrate:mysql": "node scripts/migrate-mysql.mjs",
    "db:verify:runtime:mysql": "node scripts/verify-mysql-runtime.mjs",
    "start:mysql": "node production/server.mjs",
    "preview": "npm run build && vite preview",
    "test": "vitest run",
    "test:stress": "node scripts/http-stress.mjs",
    "test:win": "vitest run --pool=threads --maxWorkers=1",
    "accounts:prepare": "node scripts/prepare-production-accounts.ts",
    "accounts:audit": "python scripts/audit-production-account-artifacts.py",
    "cf-typegen": "wrangler types",
    "postinstall": "wrangler types"
  },
  "dependencies": {
    "@react-router/node": "^8.0.0",
    "isbot": "^5.1.36",
    "lucide-react": "^0.468.0",
    "mysql2": "^3.24.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "8.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.44.0",
    "@react-router/dev": "8.0.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "vitest": "~3.2.0",
    "wrangler": "^4.110.0"
  }
}
